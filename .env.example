# ---------------------------------------------------------------------------
# dash-bord environment. Copy to .env.local for local dev; set the same names
# in Vercel → Project → Settings → Environment Variables for production.
# Every value here is server-only. Never prefix any of them with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# --- Private access (required in production) --------------------------------
# The single personal passphrase used on /login. Pick something long.
DASHBORD_PASSPHRASE=
# Signs the session cookie. ≥ 32 characters. Generate with: npm run secret
AUTH_SECRET=

# --- Persistence (required for OAuth connections + settings sync) -----------
# Any Postgres. On Vercel: Storage → Marketplace → Neon, which injects
# DATABASE_URL (POSTGRES_URL also works). Use the *pooled* connection string.
DATABASE_URL=
# 32 random bytes, base64. Encrypts OAuth refresh/access tokens at rest.
# Generate with: npm run secret   (rotating it invalidates stored connections)
TOKEN_ENCRYPTION_KEY=

# Public origin used to build OAuth redirect URIs. Optional — falls back to
# the request origin. Set it in production, e.g. https://dash-bord.vercel.app
APP_URL=

# --- Calendar ---------------------------------------------------------------
# mock (default) | google
CALENDAR_PROVIDER=mock
# Google Cloud → APIs & Services → Credentials → OAuth client (Web application)
# Authorized redirect URI: <APP_URL>/api/connect/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Weather ----------------------------------------------------------------
# mock (default) | open-meteo (no key needed) | openweathermap
WEATHER_PROVIDER=mock
# Only for WEATHER_PROVIDER=openweathermap (or to offer it in Settings)
OPENWEATHERMAP_API_KEY=

# --- Inspiration ------------------------------------------------------------
# auto (default): images from the board's public RSS feed once you paste a
#                 board URL in Settings; demo illustrations until then.
# rss | mock | pinterest (official API — needs the app + database below)
INSPIRATION_PROVIDER=auto
# developers.pinterest.com → My apps. Redirect URI:
# <APP_URL>/api/connect/pinterest/callback
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# true = also request boards:read_secret + pins:read_secret for secret boards
PINTEREST_INCLUDE_SECRET_BOARDS=false
