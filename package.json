{
  "name": "dash-bord",
  "version": "0.1.0",
  "private": true,
  "description": "A private, installable landscape desk dashboard PWA for an iPhone on a charging stand.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 node ./node_modules/next/dist/bin/next dev",
    "build": "NEXT_TELEMETRY_DISABLED=1 node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "lint": "node ./node_modules/eslint/bin/eslint.js .",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "icons": "node ./scripts/generate-icons.mjs",
    "db:migrate": "node ./scripts/migrate.mjs",
    "secret": "node ./scripts/generate-secret.mjs"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "geist": "^1.9.0",
    "ical.js": "^2.2.1",
    "jose": "^6.2.15",
    "next": "16.4.3",
    "postgres": "^3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3"
  }
}
